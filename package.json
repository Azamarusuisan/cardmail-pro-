{
  "name": "cardmail-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build --workspace=@cardmail-pro/web",
    "dev": "npm run dev --workspace=@cardmail-pro/web -- --host 0.0.0.0",
    "start": "npm run preview --workspace=@cardmail-pro/web -- --host 0.0.0.0",
    "build:all": "npm run build --workspaces --if-present"
  },
  "workspaces": [
    "apps/web",
    "server",
    "worker"
  ],
  "engines": {
    "node": "^22.23.4"
  },
  "overrides": {
    "minimatch@9": "^9.0.7",
    "postcss-selector-parser": "^7.1.6"
  }
}
